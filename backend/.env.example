# Ma'lumotlar JSON fayllarda saqlanadi (employees.json, candidates.json, users.json, ...).
# Bo‘sh bo‘lsa: backend/data/
DATA_DIR=

# JWT kaliti. Bo‘sh bo‘lsa avtomatik yaratilib backend/.secret_key ga yoziladi.
SECRET_KEY=
TOKEN_HOURS=12

# Frontend manzili (CORS). Bir nechta bo‘lsa vergul bilan.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Yuklangan hujjatlar papkasi va hajm chegarasi
UPLOAD_DIR=
MAX_UPLOAD_MB=10

# Birinchi ishga tushirishda yaratiladigan administrator (keyin parolni o‘zgartiring!)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrator

# Build papkalari (standart: ../frontend/dist va ../landing/dist). Mavjud bo‘lsa backend ularni ochadi:
#   /       — HR CRM paneli
#   /test/  — nomzodlar testi (landing)
# FRONTEND_DIST=
# LANDING_DIST=
# LANDING2_DIST=          (landing-2/dist — /test/yakuniy)

