# Backend API manzili. /api/v1 — Vite proxy orqali backendga (VITE_BACKEND_URL) uzatiladi.
# Boshqa serverdagi backend uchun to‘liq manzil: VITE_API_URL=https://api.kompaniya.uz/api/v1
VITE_API_URL=/api/v1

# Ishlab chiqishda backend qayerda ishlayapti (proxy uchun)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Nomzodlar testi (landing/) dev-serveri: CRM dagi /test/sotuv havolasi ishlab chiqishda shu yerga uzatiladi
VITE_LANDING_DEV_URL=http://127.0.0.1:5174
# Yakuniy bilim testi (landing-2/) dev-serveri: /test/yakuniy
VITE_LANDING2_DEV_URL=http://127.0.0.1:5175

# Backendsiz, faqat brauzerda (demo) ishlatish uchun: true
VITE_USE_MOCK=false

# Mock javoblar uchun sun'iy kechikish (ms)
VITE_MOCK_DELAY=450
